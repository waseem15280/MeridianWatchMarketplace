# =========================================================================
# Meridian Watch Marketplace - Production Environment Template
# Instructions: Copy this file to .env on the production server:
#   cp .env.example .env
# =========================================================================

REGISTRY=ghcr.io/YOUR-GITHUB-USERNAME
IMAGE_TAG=latest
GHCR_OWNER=your-github-username
GHCR_IMAGE_PREFIX=mywatchmarketplace

# Production Database Credentials
POSTGRES_USER=marketplace_admin
POSTGRES_PASSWORD=your_strong_production_password
POSTGRES_DB=MarketplaceDb
POSTGRES_MULTIPLE_DATABASES=MarketplaceDb,CollectorVaultDb,BuyerWishlistDb,SellerHubDb,CustomerOrdersDb,UserAccountDb

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# Production Email Service (SMTP)
EMAIL_USE_MOCK=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SENDER_NAME=THC Watch Marketplace
SMTP_SENDER_EMAIL=no-reply@thcwatches.com
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_app_password
SMTP_ENABLE_SSL=true
FRONTEND_BASE_URL=https://yourdomain.com
TOKEN_EXPIRATION_MINUTES=60

