# =========================================================================
# Meridian Watch Marketplace - Environment Configuration Template
# Instructions: Copy this file to .env and configure your secrets:
#   cp .env.example .env
# =========================================================================

# Database Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=MarketplaceDb
POSTGRES_MULTIPLE_DATABASES=MarketplaceDb,CollectorVaultDb,BuyerWishlistDb,SellerHubDb,CustomerOrdersDb,UserAccountDb,ServiceCenterDb

# Cloudinary Media Storage Secrets
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# Database Connection Strings (Optional overrides - defaults to postgres container)
CONNECTION_STRINGS_MARKETPLACE=Host=postgres;Port=5432;Database=MarketplaceDb;Username=postgres;Password=your_secure_password_here
CONNECTION_STRINGS_COLLECTOR_VAULT=Host=postgres;Port=5432;Database=CollectorVaultDb;Username=postgres;Password=your_secure_password_here
CONNECTION_STRINGS_BUYER_WISHLIST=Host=postgres;Port=5432;Database=BuyerWishlistDb;Username=postgres;Password=your_secure_password_here
CONNECTION_STRINGS_SELLER_HUB=Host=postgres;Port=5432;Database=SellerHubDb;Username=postgres;Password=your_secure_password_here
CONNECTION_STRINGS_CUSTOMER_ORDERS=Host=postgres;Port=5432;Database=CustomerOrdersDb;Username=postgres;Password=your_secure_password_here
CONNECTION_STRINGS_USER_ACCOUNT=Host=postgres;Port=5432;Database=UserAccountDb;Username=postgres;Password=your_secure_password_here
CONNECTION_STRINGS_SERVICE_CENTER=Host=postgres;Port=5432;Database=ServiceCenterDb;Username=postgres;Password=your_secure_password_here

# Gateway & Frontend URLs
VITE_API_GATEWAY_URL=http://localhost:5000
FRONTEND_BASE_URL=http://localhost:3000

# Email Service Settings
EMAIL_USE_MOCK=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SENDER_NAME=THC Watch Marketplace
SMTP_SENDER_EMAIL=no-reply@thcwatches.com
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_ENABLE_SSL=true
TOKEN_EXPIRATION_MINUTES=60
