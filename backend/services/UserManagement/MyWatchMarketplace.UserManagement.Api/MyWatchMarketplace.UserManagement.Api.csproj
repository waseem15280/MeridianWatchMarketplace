      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MyWatchMarketplace.UserManagement.Application\MyWatchMarketplace.UserManagement.Application.csproj" />
    <ProjectReference Include="..\MyWatchMarketplace.UserManagement.Infrastructure\MyWatchMarketplace.UserManagement.Infrastructure.csproj" />
  </ItemGroup>

</Project>
