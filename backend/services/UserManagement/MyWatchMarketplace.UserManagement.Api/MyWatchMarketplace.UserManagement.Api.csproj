    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MyWatchMarketplace.UserManagement.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
