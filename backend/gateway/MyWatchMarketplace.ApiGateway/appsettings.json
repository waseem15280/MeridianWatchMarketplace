{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "marketplace-route": {
        "ClusterId": "marketplace-cluster",
        "Match": {
          "Path": "/api/marketplace/{**catch-all}"
        }
      },
      "collector-vault-route": {
        "ClusterId": "collector-vault-cluster",
        "Match": {
          "Path": "/api/collector-vault/{**catch-all}"
        }
      },
      "buyer-wishlist-route": {
        "ClusterId": "buyer-wishlist-cluster",
        "Match": {
          "Path": "/api/buyer-wishlist/{**catch-all}"
        }
      },
      "seller-hub-route": {
        "ClusterId": "seller-hub-cluster",
        "Match": {
          "Path": "/api/seller-hub/{**catch-all}"
        }
      },
      "customer-orders-route": {
        "ClusterId": "customer-orders-cluster",
        "Match": {
          "Path": "/api/customer-orders/{**catch-all}"
        }
      },
      "user-management-route": {
        "ClusterId": "user-management-cluster",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "marketplace-cluster": {
        "Destinations": {
          "marketplace-destination": {
            "Address": "http://localhost:5101"
          }
        }
      },
      "collector-vault-cluster": {
        "Destinations": {
          "collector-vault-destination": {
            "Address": "http://localhost:5102"
          }
        }
      },
      "buyer-wishlist-cluster": {
        "Destinations": {
          "buyer-wishlist-destination": {
            "Address": "http://localhost:5103"
          }
        }
      },
      "seller-hub-cluster": {
        "Destinations": {
          "seller-hub-destination": {
            "Address": "http://localhost:5104"
          }
        }
      },
      "customer-orders-cluster": {
        "Destinations": {
          "customer-orders-destination": {
            "Address": "http://localhost:5105"
          }
        }
      },
      "user-management-cluster": {
        "Destinations": {
          "user-management-destination": {
            "Address": "http://localhost:5106"
          }
        }
      }
    }
  }
}

